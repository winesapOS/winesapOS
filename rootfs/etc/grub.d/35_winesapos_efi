#!/bin/bash

# The 'os-prober' GRUB plugin does not work with Btrfs subvolumes. For example, Fedora uses that by
# default. This script takes advantage of UEFI and known operating systems to handle adding
# dual-boot entries.

set -e

# shellcheck disable=SC1091
. /usr/share/grub/grub-mkconfig_lib

esp="/boot/efi"

if [[ ! -d "${esp}/EFI" ]]; then
    exit 0
fi

esp_uuid="$(grub-probe --target=fs_uuid "${esp}" 2> /dev/null)" || exit 0
if [[ -z "${esp_uuid}" ]]; then
    exit 0
fi

winesapos_efi_name() {
    case "${1,,}" in
        debian)    echo "Debian" ;;
        fedora)    echo "Fedora" ;;
        ubuntu)    echo "Ubuntu" ;;
        microsoft) echo "Windows Boot Manager" ;;
        steamos)   echo "SteamOS" ;;
        *)         echo "${1}" ;;
    esac
}

found=0

for vendor_dir in "${esp}"/EFI/*/; do
    [[ -d "${vendor_dir}" ]] || continue
    vendor="$(basename "${vendor_dir}")"

    # "BOOT" is the removable fallback loader, which is a copy of one of the others. winesapOS is
    # already covered by the entries that '10_linux' generates.
    case "${vendor,,}" in
        boot|winesapos) continue ;;
    esac

    # Prefer the signed shim so that the entry keeps working with Secure Boot enabled.
    loader=""
    for candidate in \
      "EFI/${vendor}/shimx64.efi" \
      "EFI/${vendor}/grubx64.efi" \
      "EFI/${vendor}/Boot/bootmgfw.efi" \
      "EFI/${vendor}/bootmgfw.efi" \
      "EFI/${vendor}/systemd-bootx64.efi"; do
        if [[ -f "${esp}/${candidate}" ]]; then
            loader="/${candidate}"
            break
        fi
    done

    if [[ -z "${loader}" ]]; then
        continue
    fi

    name="$(winesapos_efi_name "${vendor}")"
    echo "Found ${name} on the EFI system partition: ${loader}" >&2
    found=1

    cat <<EOF
menuentry '${name}' --class ${vendor,,} --class os \$menuentry_id_option 'winesapos-efi-${vendor,,}' {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=root ${esp_uuid}
    chainloader ${loader}
}
EOF
done

if [[ "${found}" == "0" ]]; then
    echo "No other UEFI operating systems were found on the EFI system partition." >&2
fi
